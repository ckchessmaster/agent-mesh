<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AgentMesh.ServiceDefaults\AgentMesh.ServiceDefaults.csproj" />
    <ProjectReference Include="..\AgentMesh.Infrastructure\AgentMesh.Infrastructure.csproj" />
    <ProjectReference Include="..\AgentMesh.Core\AgentMesh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests drive the quota probe's parser and its injected CLI runner directly, which
         keeps real provider round-trips (and a signed-in `agy`) out of the test suite. -->
    <InternalsVisibleTo Include="AgentMesh.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="Aspire.StackExchange.Redis" Version="13.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Temporalio" Version="1.20.0" />
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="1.20.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
