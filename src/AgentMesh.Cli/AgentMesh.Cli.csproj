<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>agentmesh</AssemblyName>
    <RootNamespace>AgentMesh.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMesh.Core\AgentMesh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DriverIdentity.ResolveName/ResolveRole are pure identity decisions; unit tests pin them
         without standing up a mesh connection. -->
    <InternalsVisibleTo Include="AgentMesh.Tests" />
  </ItemGroup>

</Project>
