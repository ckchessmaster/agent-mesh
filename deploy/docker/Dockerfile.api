FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/AgentMesh.Api/AgentMesh.Api.csproj
RUN dotnet publish src/AgentMesh.Api/AgentMesh.Api.csproj -c Release -o /app/publish
RUN dotnet publish src/AgentMesh.Cli/AgentMesh.Cli.csproj -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o /app/cli-publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=22
ENV PATH="/root/.local/bin:/usr/local/bin:${PATH}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/99network-resilience \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    gnupg \
    tar \
    gzip \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && curl -4fsSL --retry 5 --retry-all-errors https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && curl -4fsSL --retry 5 --retry-all-errors https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends gh nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && curl -4fsSL --retry 5 --retry-all-errors https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin \
    && chmod +x /usr/local/bin/agy \
    && mkdir -p /root/.gemini/antigravity-cli /root/.claude /root/.config /root/.agentmesh/tokens \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/publish .
COPY --from=build /app/cli-publish/agentmesh /usr/local/bin/agentmesh
RUN chmod +x /usr/local/bin/agentmesh
ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "AgentMesh.Api.dll"]
