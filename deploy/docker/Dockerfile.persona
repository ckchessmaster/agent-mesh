FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=22
ENV PATH="/root/.local/bin:/usr/local/bin:${PATH}"
ENV TERM="xterm-256color"
ENV REMOTE_CONTAINERS=true

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 1. Install base utilities, Python 3, GitHub CLI, Node.js, and CLIs
RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/99network-resilience \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    jq \
    tar \
    gzip \
    unzip \
    ca-certificates \
    gnupg \
    bsdutils \
    procps \
    iproute2 \
    dnsutils \
    iputils-ping \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && curl -4fsSL --retry 5 --retry-all-errors https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && curl -4fsSL --retry 5 --retry-all-errors https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends gh nodejs \
    && npm install -g pnpm @anthropic-ai/claude-code @github/copilot \
    && curl -4fsSL --retry 5 --retry-all-errors https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin \
    && chmod +x /usr/local/bin/agy \
    && rm -rf /var/lib/apt/lists/*

# 2. Build AgentMesh CLI binary
WORKDIR /src
COPY . .
RUN dotnet publish src/AgentMesh.Cli/AgentMesh.Cli.csproj \
    -c Release \
    -r linux-x64 \
    --self-contained true \
    -p:PublishSingleFile=true \
    -p:IncludeNativeLibrariesForSelfExtract=true \
    -o /app/cli \
    && cp /app/cli/agentmesh /usr/local/bin/agentmesh \
    && chmod +x /usr/local/bin/agentmesh \
    && rm -rf /src

# 3. Prepare workspace, home config dirs & entrypoint
RUN mkdir -p /workspace /root/.gemini/antigravity-cli /root/.claude /root/.copilot /root/.config \
    && git config --global --add safe.directory '*'


COPY deploy/docker/entrypoint.persona.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
