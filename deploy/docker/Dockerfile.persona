FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=22

# 1. Install base utilities and Python 3
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    jq \
    tar \
    gzip \
    unzip \
    ca-certificates \
    procps \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Node.js 22 LTS and pnpm
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g pnpm \
    && rm -rf /var/lib/apt/lists/*

# 3. Build AgentMesh CLI binary
WORKDIR /src
COPY . .
RUN dotnet publish src/AgentMesh.Cli/AgentMesh.Cli.csproj \
    -c Release \
    -r linux-x64 \
    --self-contained true \
    -p:PublishSingleFile=true \
    -p:IncludeNativeLibrariesForSelfExtract=true \
    -o /app/cli \
    && cp /app/cli/agentmesh /usr/local/bin/agentmesh \
    && chmod +x /usr/local/bin/agentmesh \
    && rm -rf /src

# 4. Prepare workspace & entrypoint
RUN mkdir -p /workspace && git config --global --add safe.directory '*'

COPY deploy/docker/entrypoint.persona.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
