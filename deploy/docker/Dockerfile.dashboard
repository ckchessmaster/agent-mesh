# Build stage
FROM node:22-alpine AS build
WORKDIR /app
COPY src/AgentMesh.Dashboard/package*.json ./
RUN npm ci
COPY src/AgentMesh.Dashboard/ ./
RUN npm run build

# Serve stage
FROM nginx:alpine
COPY deploy/docker/nginx.dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
