<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">1.0.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">1.0.0</InformationalVersion>
    <Authors>Christopher Kingdon</Authors>
    <Company>Christopher Kingdon</Company>
    <Product>AgentMesh</Product>
    <Copyright>Copyright © 2026 Christopher Kingdon</Copyright>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904;CS9113;CS8524;CS8625;CS8619;CS8602;CS8600</NoWarn>
  </PropertyGroup>
</Project>
